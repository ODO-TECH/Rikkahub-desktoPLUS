# RikkaHub Desktop PLUS —— 容器环境变量样例
#
# 用法：cp .env.example .env，然后按需修改。.env 含密码，不要提交进版本库。
# compose 会读同目录的 .env；也可以直接 export 同名环境变量。

# 必填：Web 访问密码。未设置时 compose 拒绝启动。
RIKKAHUB_PASSWORD=换成你的密码

# 宿主机监听地址与端口
#   RIKKAHUB_BIND_ADDR 默认 0.0.0.0（局域网可访问）；只本机用改成 127.0.0.1
# RIKKAHUB_BIND_ADDR=0.0.0.0
# RIKKAHUB_HTTP_PORT=11451

# 容器运行身份。改了就同步 chown 宿主 ./pc-data 成同一组数字。
# RIKKAHUB_UID=1000
# RIKKAHUB_GID=1000

# 时区（镜像已装 tzdata）
# TZ=Asia/Shanghai

# 沙盒档位声明（容器与 Windows 共用同一份语义）：
#   restricted = 工作区内读写、工作区外只读（容器侧由挂载表 + 只读根 fs 兑现）
#   full      = 不设边界（应用层只做危险命令清单）
#   off       = 不声明
# compose 默认 restricted。声明不等于生效：容器内读根 fs 挂载标志判定，
# 结论在 GET /api/app/sandbox（根 fs 可写 = 没有边界，日志会点名）。
# RIKKAHUB_SANDBOX=restricted

# 可选：对指定的“区外代表点”做一次写探针。容器默认不需要设；
# 想验证某个 rw 例外挂载是否真的可写时再打开。
# RIKKAHUB_SANDBOX_PROBE_PATH=/data/documents
